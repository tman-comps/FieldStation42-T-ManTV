#!/bin/bash
# quick restart of the player only (launcher brings it back in ~3s), then back to the same channel
if pgrep -f fs42_local/start_fs42.sh >/dev/null; then
  "$HOME/.local/bin/fs42-tune-back" save >/dev/null
  pkill -9 -f field_player.py; pkill -9 -x mpv; echo "FieldStation42 restarting"
  setsid nohup "$HOME/.local/bin/fs42-tune-back" >/dev/null 2>&1 < /dev/null &
else
  "$HOME/.local/bin/fs42-start"
fi
