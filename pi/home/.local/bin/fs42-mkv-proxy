#!/usr/bin/env python3
# MKV index cache proxy (2026-11-01, Simpsons ch 12). Runs on the Pi as ~/.local/bin/fs42-mkv-proxy,
# kept up by cron (@reboot + every minute, flock -n). Source copy: ~/simpsons_build/mkv_index_proxy.py.
# Archive MKVs keep their index (SeekHead/Cues/Tags) at the end, so opening one mid-episode costs ~6 HTTP
# requests to archive.org (1-2 s each), and big MP4s (ch 7 tapes) have multi-MB moov indexes. This serves
# the index from a local cache (MKV: first HEAD + last TAIL bytes; MP4: the whole moov, front or end) from a
# and only goes to archive.org for the rest, so a channel change needs ~1 remote request.
#   fs42-mkv-proxy serve [port]        -> http://127.0.0.1:<port>/<item>/<path in item> (default 8742)
#   fs42-mkv-proxy fill <stub dir>     -> cache head/tail for every .strm under it (8 threads)
# Upstream = the direct dnNNN.archive.org link (saved per file, re-looked-up when it fails or is >48 h old).
import hashlib
import http.server
import os
import socketserver
import struct
import sys
import threading
import time
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor

CACHE = os.environ.get("FS42_MKV_CACHE", os.path.expanduser("~/.cache/fs42_mkv_index"))
HEAD, TAIL, CHUNK, URL_AGE = 128 * 1024, 256 * 1024, 64 * 1024, 48 * 3600
PROXY = "http://127.0.0.1:8742/"
_locks = {}


def base_of(path):
    return os.path.join(CACHE, hashlib.sha1(path.encode()).hexdigest())


def tmp_of(p):
    return f"{p}.{os.getpid()}.{threading.get_ident()}.tmp"


def save(p, data):
    with open(tmp_of(p), "wb") as f:
        f.write(data)
    os.replace(tmp_of(p), p)


def upstream(path, fresh=False):
    """Direct archive.org server link for <item>/<path>, saved next to the cache entry."""
    p = base_of(path) + ".url"
    if not fresh and os.path.exists(p) and time.time() - os.path.getmtime(p) < URL_AGE:
        return open(p).read().strip()
    url = "https://archive.org/download/" + path.lstrip("/")
    try:
        with urllib.request.urlopen(urllib.request.Request(url, method="HEAD"), timeout=30) as r:
            if r.status == 200 and r.geturl() != url:
                url = r.geturl()
                os.makedirs(CACHE, exist_ok=True)
                save(p, url.encode())
    except Exception:
        pass
    return url


def get(url, start, end=None, timeout=30):
    rng = f"bytes={start}-{'' if end is None else end}"
    return urllib.request.urlopen(urllib.request.Request(url, headers={"Range": rng}), timeout=timeout)


def get_path(path, start, end=None):
    try:
        return get(upstream(path), start, end)
    except Exception:
        return get(upstream(path, fresh=True), start, end)   # server moved: look the link up again


def mp4_moov(path, size, first):
    """(offset, size) of an MP4's moov box (its index), walking the top-level box headers; None if not MP4."""
    if first[4:8] != b"ftyp":
        return None
    pos = 0
    for _ in range(40):
        if pos + 16 > size:
            return None
        hdr = first[pos:pos + 16] if pos + 16 <= len(first) else get_path(path, pos, pos + 15).read()
        n, t = struct.unpack(">I4s", hdr[:8])
        if n == 1:
            n = struct.unpack(">Q", hdr[8:16])[0]
        elif n == 0:
            n = size - pos
        if t == b"moov":
            return pos, n
        if n < 8:
            return None
        pos += n
    return None


def fetch_to(path, start, end, dest):
    r = get_path(path, start, end)
    with open(tmp_of(dest), "wb") as f:
        while True:
            data = r.read(CHUNK)
            if not data:
                break
            f.write(data)
    os.replace(tmp_of(dest), dest)


def entry(path):
    with _locks.setdefault(path, threading.Lock()):   # several stubs can share one file (ch 7 tapes)
        return _entry(path)


def _entry(path):
    """(size, head length, tail length, cache base), fetched once per file and kept in CACHE.
    MKV: first HEAD + last TAIL bytes. MP4: the whole moov index (front or end) plus the start of the file."""
    base = base_of(path)
    if os.path.exists(base + ".size"):   # .size is written last
        return (int(open(base + ".size").read()), os.path.getsize(base + ".head"),
                os.path.getsize(base + ".tail"), base)
    os.makedirs(CACHE, exist_ok=True)
    r = get_path(path, 0, HEAD - 1)
    size = int(r.headers["Content-Range"].rsplit("/", 1)[1])
    first = r.read()
    head_len, tail_len = HEAD, TAIL
    moov = mp4_moov(path, size, first)
    if moov:
        o, n = moov
        if o < size // 2:
            head_len, tail_len = o + n, 64 * 1024     # index at the front
        else:
            tail_len = size - o                       # index at the end
    head_len = min(head_len, size)
    tail_len = min(tail_len, size - head_len)
    if head_len <= len(first):
        save(base + ".head", first[:head_len])
    else:
        fetch_to(path, 0, head_len - 1, base + ".head")
    if tail_len:
        fetch_to(path, size - tail_len, size - 1, base + ".tail")
    else:
        save(base + ".tail", b"")
    save(base + ".size", str(size).encode())
    return size, head_len, tail_len, base


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, *a):
        pass

    def do_HEAD(self):
        self.do_GET(body=False)

    def do_GET(self, body=True):
        path = urllib.parse.unquote(urllib.parse.urlsplit(self.path).path)
        qpath = urllib.parse.quote(path.lstrip("/"))
        try:
            size, head_len, tail_len, base = entry(qpath)
        except Exception as e:
            self.send_error(502, str(e)[:100])
            return
        start, end = 0, size - 1
        rng = self.headers.get("Range", "")
        if rng.startswith("bytes="):
            a, _, b = rng[6:].partition("-")
            start, end = int(a or 0), min(int(b) if b else size - 1, size - 1)
        if start >= size:
            self.send_response(416)
            self.send_header("Content-Range", f"bytes */{size}")
            self.send_header("Content-Length", "0")
            self.end_headers()
            return
        self.send_response(206 if rng else 200)
        self.send_header("Content-Type", "video/mp4" if qpath.lower().endswith(".mp4") else "video/x-matroska")
        self.send_header("Accept-Ranges", "bytes")
        self.send_header("Content-Length", str(end - start + 1))
        if rng:
            self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True
        if body:
            self.send_body(qpath, size, head_len, tail_len, base, start, end)

    def copy_file(self, p, at, n):
        with open(p, "rb") as f:
            f.seek(at)
            while n > 0:
                data = f.read(min(CHUNK, n))
                if not data:
                    return
                self.wfile.write(data)
                n -= len(data)

    def send_body(self, qpath, size, head_len, tail_len, base, pos, end):
        tail_start = size - tail_len
        up = {}

        def open_up(at):    # opened early, in the background, so the hand-off from cache doesn't stall
            try:
                up["r"] = get_path(qpath, at, end)
            except Exception as e:
                up["err"] = e
        t = None
        if pos < head_len and end >= head_len and head_len < tail_start:
            t = threading.Thread(target=open_up, args=(head_len,), daemon=True)
            t.start()
        try:
            if pos < head_len:
                stop = min(end + 1, head_len)
                self.copy_file(base + ".head", pos, stop - pos)
                pos = stop
            if pos <= end and pos < tail_start:
                stop = min(end, tail_start - 1)
                if t:
                    t.join()
                    r = up.get("r")
                    if r is None:
                        raise up.get("err") or OSError("upstream")
                else:
                    r = get_path(qpath, pos, end)
                while pos <= stop:
                    data = r.read(min(CHUNK, stop - pos + 1))
                    if not data:
                        return
                    self.wfile.write(data)
                    pos += len(data)
                r.close()
            if pos <= end:
                self.copy_file(base + ".tail", pos - tail_start, end + 1 - pos)
        except (BrokenPipeError, ConnectionResetError):
            pass
        finally:
            if up.get("r"):
                up["r"].close()


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def fill(stub_dir):
    paths = []
    for root, _, files in os.walk(stub_dir, followlinks=True):
        for n in files:
            if n.endswith(".strm"):
                u = open(os.path.join(root, n)).readline().strip()
                for pre in ("https://archive.org/download/", PROXY):
                    if u.startswith(pre):
                        paths.append(u[len(pre):])

    def one(p):
        try:
            entry(p)
            return None
        except Exception as e:
            return f"{p}: {e}"
    with ThreadPoolExecutor(8) as ex:
        errs = [e for e in ex.map(one, paths) if e]
    print(f"{len(paths) - len(errs)} of {len(paths)} cached in {CACHE}")
    for e in errs[:10]:
        print("  fail", e)


if __name__ == "__main__":
    if sys.argv[1:2] == ["serve"]:
        port = int(sys.argv[2]) if len(sys.argv) > 2 else 8742
        Server(("127.0.0.1", port), Handler).serve_forever()
    elif sys.argv[1:2] == ["fill"] and len(sys.argv) == 3:
        fill(sys.argv[2])
    else:
        print("usage: serve [port] | fill <stub dir>")
