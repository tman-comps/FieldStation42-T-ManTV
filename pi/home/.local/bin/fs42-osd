#!/bin/bash
# T-ManTV: xcompmgr (see-through windows) + FS42's OSD logo program
export DISPLAY=:0
exec 9>/tmp/fs42-osd.lock; flock -n 9 || exit 0
for i in $(seq 1 60); do xset q >/dev/null 2>&1 && break; sleep 1; done
pgrep -x xcompmgr >/dev/null || (xcompmgr -n >/dev/null 2>&1 &)
cd "$HOME/FieldStation42" && source env/bin/activate
while true; do
  echo "$(date '+%F %T') starting FS42 OSD" >> "$HOME/.cache/fs42-osd.log"
  python3 fs42/osd/main.py >> "$HOME/.cache/fs42-osd.log" 2>&1
  sleep 3
done
